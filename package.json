{
  "name": "@yunlai/dsh-ai-quick-links",
  "version": "0.1.2",
  "type": "module",
  "description": "DeepSeek Harness 插件：固定在窗口右下角的 AI 快捷入口，内置 20 个国产/海外 AI 对话网站。AI quick links for DeepSeek Harness.",
  "license": "MIT",
  "author": "Cyrus Cheng",
  "homepage": "https://github.com/Chengyunlai/dsh-ai-quick-links#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chengyunlai/dsh-ai-quick-links.git"
  },
  "bugs": {
    "url": "https://github.com/Chengyunlai/dsh-ai-quick-links/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "ai",
    "ai-tools",
    "quick-links",
    "launcher"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "build-icons.mjs",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "icons/*.svg",
    "index.js",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build:icons": "node build-icons.mjs",
    "check": "node scripts/check-package.mjs",
    "verify": "npm run check && node --check client.js && node --check build-icons.mjs && node build-icons.mjs && git diff --exit-code -- client.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
